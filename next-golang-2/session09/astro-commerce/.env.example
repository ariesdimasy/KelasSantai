# Salin file ini menjadi .env lalu sesuaikan.

# Base URL fiber-api (tanpa trailing slash).
# Dipakai HANYA di sisi server (Astro API routes), tidak pernah bocor ke browser.
FIBER_API_URL=http://localhost:3000

# Secret untuk menandatangani JWT (HS256). WAJIB diganti di production.
# Bikin yang random: openssl rand -base64 32
AUTH_SECRET=ubah-ini-jadi-secret-random-minimal-32-karakter

# Umur token dalam detik (default 7 hari)
AUTH_TOKEN_TTL=604800

# Nama toko — dipakai di header, footer, dan SEO
PUBLIC_SITE_NAME=Astro Commerce
