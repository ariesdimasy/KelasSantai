---
import { Package, Camera, Send, MessageCircle, Globe } from 'lucide-react';

const siteName = import.meta.env.PUBLIC_SITE_NAME ?? 'Astro Commerce';
const year = new Date().getFullYear();

const linkGroups = [
  {
    title: 'Belanja',
    links: [
      { href: '/', label: 'Semua produk' },
      { href: '/?sort=price-asc', label: 'Harga termurah' },
      { href: '/cart', label: 'Keranjang' },
      { href: '/orders', label: 'Riwayat pesanan' },
    ],
  },
  {
    title: 'Akun',
    links: [
      { href: '/signin', label: 'Masuk' },
      { href: '/register', label: 'Daftar' },
      { href: '/profile', label: 'Profil saya' },
      { href: '/home', label: 'Halaman saya' },
    ],
  },
  {
    title: 'Bantuan',
    links: [
      { href: '/#faq', label: 'FAQ' },
      { href: '/#pengiriman', label: 'Info pengiriman' },
      { href: '/#pembayaran', label: 'Metode pembayaran' },
      { href: '/dashboard', label: 'Dashboard admin' },
    ],
  },
];

const socials = [
  { label: 'Instagram', href: 'https://instagram.com', Icon: Camera },
  { label: 'Telegram', href: 'https://telegram.org', Icon: Send },
  { label: 'WhatsApp', href: 'https://wa.me/6281234567890', Icon: MessageCircle },
  { label: 'Website', href: 'https://astro.build', Icon: Globe },
];
---

<footer class="mt-16 border-t bg-muted/40">
  <div class="container-page grid gap-10 py-12 md:grid-cols-[1.4fr_repeat(3,1fr)]">
    <div class="space-y-3">
      <div class="flex items-center gap-2 font-semibold">
        <span class="grid size-9 place-items-center rounded-lg bg-primary text-primary-foreground">
          <Package className="size-5" />
        </span>
        {siteName}
      </div>
      <p class="max-w-sm text-sm text-muted-foreground">
        Toko online demo untuk materi bootcamp: Astro + React + Tailwind di sisi frontend,
        Go Fiber + MySQL di sisi backend.
      </p>
      <div class="flex gap-2 pt-1">
        {
          socials.map(({ label, href, Icon }) => (
            <a
              href={href}
              target="_blank"
              rel="noopener noreferrer"
              aria-label={label}
              title={label}
              class="grid size-9 place-items-center rounded-md border bg-background transition-colors hover:bg-accent"
            >
              <Icon className="size-4" />
            </a>
          ))
        }
      </div>
    </div>

    {
      linkGroups.map((group) => (
        <nav aria-label={group.title} class="space-y-3">
          <h2 class="text-sm font-semibold">{group.title}</h2>
          <ul class="space-y-2 text-sm text-muted-foreground">
            {group.links.map((link) => (
              <li>
                <a href={link.href} class="transition-colors hover:text-foreground">{link.label}</a>
              </li>
            ))}
          </ul>
        </nav>
      ))
    }
  </div>

  <div class="border-t py-5">
    <div class="container-page flex flex-col gap-2 text-xs text-muted-foreground sm:flex-row sm:items-center sm:justify-between">
      <p>© {year} {siteName}. Dibuat untuk keperluan belajar.</p>
      <p>Frontend: Astro + React · Backend: Go Fiber</p>
    </div>
  </div>
</footer>
