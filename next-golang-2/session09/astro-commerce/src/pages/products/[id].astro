---
/**
 * Halaman detail produk + SEO.
 *
 * SEO yang dipasang di sini:
 *  - title & meta description dari nama/deskripsi produk
 *  - og:image dari image produk (preview saat di-share)
 *  - JSON-LD schema.org/Product lengkap dengan harga & ketersediaan,
 *    supaya Google bisa menampilkan rich result (harga & status stok)
 *  - JSON-LD BreadcrumbList untuk jejak navigasi di hasil pencarian
 */
import StoreLayout from '@/layouts/StoreLayout.astro';
import { AddToCartButton } from '@/components/storefront/AddToCartButton';
import { ProductCard } from '@/components/storefront/ProductCard';
import { getProduct, listProducts } from '@/lib/server/catalog';
import { formatIDR, truncate } from '@/lib/utils';
import { ChevronRight, ImageIcon, Package, ShieldCheck, Truck } from 'lucide-react';

const id = Number(Astro.params.id);

if (!Number.isInteger(id) || id <= 0) {
  return Astro.redirect('/404', 302);
}

const product = await getProduct(id);

if (!product) {
  // 404 asli, bukan redirect — supaya mesin pencari tahu halaman ini tidak ada
  return new Response(null, { status: 404, statusText: 'Produk tidak ditemukan' });
}

// Produk lain dari kategori yang sama
const related = await listProducts({ categoryId: product.categoryId, limit: 5 });
const relatedProducts = related.data.filter((item) => item.id !== product.id).slice(0, 4);

const description = truncate(product.description, 155);
const inStock = product.stock > 0 && product.isActive;

const jsonLd = {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'Product',
      name: product.name,
      description: product.description,
      sku: `PRD-${product.id}`,
      image: product.imageUrl ? new URL(product.imageUrl, Astro.url.origin).href : undefined,
      category: product.category?.name,
      offers: {
        '@type': 'Offer',
        url: Astro.url.href,
        priceCurrency: 'IDR',
        price: product.price,
        availability: inStock
          ? 'https://schema.org/InStock'
          : 'https://schema.org/OutOfStock',
        itemCondition: 'https://schema.org/NewCondition',
      },
    },
    {
      '@type': 'BreadcrumbList',
      itemListElement: [
        { '@type': 'ListItem', position: 1, name: 'Beranda', item: Astro.url.origin },
        ...(product.category
          ? [
              {
                '@type': 'ListItem',
                position: 2,
                name: product.category.name,
                item: `${Astro.url.origin}/?category_id=${product.categoryId}`,
              },
            ]
          : []),
        { '@type': 'ListItem', position: product.category ? 3 : 2, name: product.name },
      ],
    },
  ],
};
---

<StoreLayout
  title={product.name}
  description={description}
  image={product.imageUrl}
  jsonLd={jsonLd}
>
  <div class="container-page py-8">
    <!-- Breadcrumb -->
    <nav aria-label="Breadcrumb" class="mb-6 flex flex-wrap items-center gap-1 text-sm text-muted-foreground">
      <a href="/" class="hover:text-foreground">Beranda</a>
      <ChevronRight className="size-4" />
      {
        product.category && (
          <>
            <a href={`/?category_id=${product.categoryId}`} class="hover:text-foreground">
              {product.category.name}
            </a>
            <ChevronRight className="size-4" />
          </>
        )
      }
      <span class="text-foreground">{product.name}</span>
    </nav>

    <div class="grid gap-10 lg:grid-cols-2">
      <div class="overflow-hidden rounded-xl border bg-muted">
        {
          product.imageUrl ? (
            <img
              src={product.imageUrl}
              alt={product.name}
              width={800}
              height={600}
              class="aspect-4/3 size-full object-cover"
            />
          ) : (
            <div class="grid aspect-4/3 place-items-center text-muted-foreground">
              <ImageIcon className="size-16" />
            </div>
          )
        }
      </div>

      <div class="space-y-5">
        <div class="space-y-2">
          {
            product.category && (
              <a
                href={`/?category_id=${product.categoryId}`}
                class="inline-block rounded-md bg-secondary px-2 py-0.5 text-xs font-medium text-secondary-foreground"
              >
                {product.category.name}
              </a>
            )
          }
          <h1 class="text-3xl font-semibold tracking-tight">{product.name}</h1>
          <p class="text-3xl font-bold text-primary">{formatIDR(product.price)}</p>
        </div>

        <dl class="grid grid-cols-2 gap-3 text-sm">
          <div class="rounded-lg border p-3">
            <dt class="text-muted-foreground">Stok</dt>
            <dd class="font-medium">
              {inStock ? `${product.stock} tersedia` : 'Kosong'}
            </dd>
          </div>
          <div class="rounded-lg border p-3">
            <dt class="text-muted-foreground">Kode produk</dt>
            <dd class="font-medium">PRD-{product.id}</dd>
          </div>
        </dl>

        <!-- client:load karena tombol ini harus langsung bisa dipakai -->
        <AddToCartButton client:load product={product} layout="detail" />

        <div class="space-y-2 rounded-lg bg-muted/60 p-4 text-sm">
          <p class="flex items-center gap-2"><Truck className="size-4 text-primary" /> Gratis ongkir untuk belanja di atas Rp 500.000</p>
          <p class="flex items-center gap-2"><ShieldCheck className="size-4 text-primary" /> Pembayaran aman, data pesanan tersimpan di akun Anda</p>
          <p class="flex items-center gap-2"><Package className="size-4 text-primary" /> Dikirim 1×24 jam setelah pembayaran</p>
        </div>

        <div class="space-y-2">
          <h2 class="font-semibold">Deskripsi produk</h2>
          <p class="text-sm leading-relaxed whitespace-pre-line text-muted-foreground">
            {product.description}
          </p>
        </div>
      </div>
    </div>

    {
      relatedProducts.length > 0 && (
        <section class="mt-16">
          <h2 class="mb-5 text-xl font-semibold tracking-tight">Produk serupa</h2>
          <div class="grid gap-5 sm:grid-cols-2 lg:grid-cols-4">
            {relatedProducts.map((item) => <ProductCard client:visible product={item} />)}
          </div>
        </section>
      )
    }
  </div>
</StoreLayout>
